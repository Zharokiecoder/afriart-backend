# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/afriart-marketplace

# JWT Secret (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Paystack Payment (from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Client URL (your Vercel frontend URL)
CLIENT_URL=https://afriart-marketplace.vercel.app

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
